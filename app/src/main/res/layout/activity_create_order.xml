<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Создание заказа"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp" />

    <!-- Контейнер для адреса подачи -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pickupContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pickupLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Адрес подачи"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCurrentLocation"
            app:layout_constraintHorizontal_weight="4"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/etPickupAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnCurrentLocation"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="📍"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/pickupLayout"
            app:layout_constraintBottom_toBottomOf="@id/pickupLayout"
            app:layout_constraintStart_toEndOf="@id/pickupLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Контейнер для адреса назначения -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dropoffContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/pickupContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dropoffLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Адрес назначения"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSelectOnMap"
            app:layout_constraintHorizontal_weight="4"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/etDropoffAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSelectOnMap"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="🗺️"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/dropoffLayout"
            app:layout_constraintBottom_toBottomOf="@id/dropoffLayout"
            app:layout_constraintStart_toEndOf="@id/dropoffLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Стоимость: рассчитывается..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        app:layout_constraintTop_toBottomOf="@id/dropoffContainer"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp" />

    <Button
        android:id="@+id/btnCreateOrder"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Создать заказ"
        android:textAllCaps="false"
        android:backgroundTint="#4CAF50"
        app:layout_constraintBottom_toTopOf="@id/btnCancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Отмена"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>